# Copy this template to backend/.env on the production server, fill every
# secret there, and keep the real file out of Git.
NODE_ENV=production
PORT=5064
FRONTEND_URL=https://echoo.digi02.org

# Production database and authentication secrets.
MONGODB_URI=
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_POOL_SIZE=25
JWT_SECRET=
JWT_REFRESH_SECRET=

# Browser origin. The backend separately allows the exact packaged Windows
# client origin echoo-app://app in code; no null-origin or desktop runtime flag is used.
CLIENT_ORIGINS=https://echoo.digi02.org

# LiveKit Cloud. Keep the API key and secret server-only.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_PUBLIC_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SERVER_RECORDING_ENABLED=true
LIVEKIT_RECORDING_WS_URL=wss://echoo.digi02.org/api/internal/livekit-recording
MEDIA_RELAY_MODE=livekit-only

# Mandatory canonical MP3 and non-destructive trim tooling.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
AUDIO_REPLAY_MP3_BITRATE=320k

# Persistent local disk is used when AUDIO_STORAGE_PROVIDER is blank.
AUDIO_STORAGE_PROVIDER=

# Optional integrations.
REDIS_URL=redis://127.0.0.1:6379
TRANSCRIPTION_ENABLED=false
WHISPER_FLOW_URL=ws://127.0.0.1:8181/ws
WHISPER_FLOW_API_KEY=
