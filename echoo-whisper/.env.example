WHISPER_FLOW_API_KEY=replace-with-a-long-random-secret
# Optional second bearer credential accepted by this service when the backend
# uses WHISPER_QUALITY_FLOW_API_KEY for a dedicated quality connection.
WHISPER_QUALITY_FLOW_API_KEY=
WHISPER_MODEL=faster-whisper-large-v3-turbo
WHISPER_LANGUAGE=en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_CPU_THREADS=4
WHISPER_MODEL_DIR=/models
# Optional absolute/local snapshot path avoids Hub checks in air-gapped deployments.
WHISPER_MODEL_PATH=
WHISPER_PARTIAL_INTERVAL_MS=1000
WHISPER_SILENCE_FINALIZE_MS=700
WHISPER_MIN_UTTERANCE_MS=300
WHISPER_MAX_UTTERANCE_MS=30000
WHISPER_MAX_SESSION_BUFFER_BYTES=2097152
WHISPER_RECONNECT_GRACE_SECONDS=60

# Quality verification. Lossless browser recording chunks are the authoritative
# quality path when their backend handshake succeeds. This flag keeps the older
# inline second pass available only as a fallback when durable chunking cannot
# start; dedicated qualityPass websocket sessions always use quality decoding.
WHISPER_QUALITY_PASS_ENABLED=true
WHISPER_QUALITY_BEAM_SIZE=5
WHISPER_QUALITY_BEST_OF=5
WHISPER_QUALITY_MAX_PENDING=16
# Leave these blank to reuse the live model. Set a dedicated quality model when
# the host has enough CPU/GPU memory and you want quality inference isolated from
# low-latency live draft inference.
WHISPER_QUALITY_DEDICATED_MODEL=false
WHISPER_QUALITY_MODEL=
WHISPER_QUALITY_MODEL_PATH=

WHISPER_LOG_LEVEL=INFO
