# Echoo public frontend build variables
# Copy to .env.production or provide these values through your chosen hosting/deployment method.

# Must be the public HTTPS Echoo API URL and must end with /api.
# Example: https://api.echoo.example.com/api
VITE_API_URL=

# Public LiveKit websocket URL returned to Creator and Listener browsers.
# For LiveKit Cloud this is normally wss://<project-host>.livekit.cloud
VITE_LIVEKIT_URL=
