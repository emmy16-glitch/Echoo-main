{
  "name": "echoo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cf:check": "node scripts/check-cloudflare-env.mjs",
    "cf:login": "npx wrangler@latest login",
    "cf:create": "npx wrangler@latest pages project create echoo-test --production-branch integration/echoo-core-cleanup",
    "cf:deploy": "npm run cf:check && npm run build && npx wrangler@latest pages deploy dist --project-name echoo-test --branch integration/echoo-core-cleanup"
  },
  "dependencies": {
    "livekit-client": "^2.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^8.2.0"
  }
}
