VITE_API_URL=/api
VITE_LIVEKIT_URL=ws://127.0.0.1:7880
VITE_SYNTHETIC_AUDIO=false

# Browser-local primary live transcription. The creator does not manually
# install/download a model: parakeet.js fetches it on first Creator Studio use
# and reuses browser-managed cache on later visits.
VITE_PARAKEET_ENABLED=true
VITE_PARAKEET_MODEL=parakeet-tdt-0.6b-v3
VITE_PARAKEET_MODEL_SOURCE=hub
VITE_PARAKEET_ENCODER_QUANT=fp32
VITE_PARAKEET_DECODER_QUANT=int8
VITE_PARAKEET_PREPROCESSOR=js

# Never put GEMINI_API_KEY or LiveKit secrets in this file. Gemini Live receives
# only short-lived, constrained tokens minted by the authenticated backend.
