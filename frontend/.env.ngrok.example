# =============================================
# Echoo frontend: ngrok tunnel development
# =============================================
# Copy this file to frontend/.env when exposing the app through ngrok:
#
#   cp frontend/.env.ngrok.example frontend/.env
#
# Vite reads this only at startup, so restart `npm run dev` after editing.

# Public ngrok backend URL, ending in /api.
# This is printed by `ngrok http 5001`, e.g.
#   https://moonscape-wages-serrated.ngrok-free.dev/api
# Update it every time you restart ngrok (free plan = random subdomain).
VITE_API_URL=

# LiveKit. When the page is served over HTTPS (any ngrok frontend URL),
# browsers refuse local ws:// connections. Public testing requires a
# public wss:// LiveKit endpoint (e.g. LiveKit Cloud), returned by the
# backend in the room token response.
VITE_LIVEKIT_URL=

VITE_SYNTHETIC_AUDIO=false
