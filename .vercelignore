# Echoo staging (.vercelignore) — keep Vercel source uploads small.
# Only frontend/, backend/ (+ root config) are needed by echoo-staging services.
# NEVER ignore: frontend/src, frontend/public, frontend/package*.json,
# frontend/vite.config.js, frontend/index.html, backend/src,
# backend/package*.json, vercel.json.

# Git / Vercel metadata
.git
.git-permission-backup-20260921
.vercel

# Dependencies (Vercel reinstalls per service during build)
node_modules
**/node_modules

# Build output (rebuilt on Vercel)
dist
**/dist
build
**/build
.next
**/.next
out
**/out

# Local databases / runtime data
.mongodb
**/.mongodb
backend/mongo-data
uploads
**/uploads
backend/uploads
logs
**/logs

# Test / coverage / caches
coverage
**/coverage
.cache
**/.cache
.vite
**/.vite
playwright-report
test-results
frontend/e2e/screenshots
frontend/test-screenshots
frontend/design-qa-evidence

# Python (echoo-whisper venv is ~5GB locally; service sources stay tracked)
.venv
venv
**/venv
__pycache__
**/__pycache__
*.pyc

# Backups / archives
backup
backups
**/backup
**/backups
*.bak
*.backup
*.zip
*.tar
*.tar.gz
*.7z

# Local editor / agent tooling
.vscode
.idea
.aider.tags.cache.v4
.codex

# Secrets / local env (never upload)
.env
.env.*
**/.env
**/.env.*

# Local generated media / artifacts
backend/artifacts
frontend/artifacts

# Misc
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# ---- Large local-only trees (not used by Vercel services) ----
# Untracked duplicate checkout of this repo
Echoo-main
# Local whisper GPU venv + models (~5GB)
echoo-whisper/venv
echoo-whisper/echoo-whisper
# Packaged desktop installers + old discards
desktop/dist
desktop-old-discarded
# Media-server build tree (own .git, ~70MB)
OvenMediaEngine
# Pre-update backend snapshot
backend-pre-update-20260907
# Root QA screenshots (tracked logo.png/home.png are kept)
Screenshot from *.png

# Local debug/probe scripts
frontend/*.tmp.mjs
