NODE_ENV=production
PORT=5017

# Exact public frontend origin(s), comma-separated.
# Digi02 production uses https://echoo.digi02.org.
CLIENT_ORIGINS=https://your-echoo-domain.example
# Optional trusted preview suffixes. Leave blank unless you intentionally use them.
CLIENT_ORIGIN_SUFFIXES=

# MongoDB Atlas or another public MongoDB deployment.
MONGODB_URI=
# Bounded pool for listener bursts, chat and creator dashboard traffic.
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_POOL_SIZE=25

# Use two different long random values.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Transactional email via Resend. EMAIL_FROM must be a verified sender.
RESEND_API_KEY=
EMAIL_FROM=Echoo <no-reply@yourdomain.com>
EMAIL_NEW_SIGNIN_ALERTS=false

# Public frontend base used to build password-reset links in emails.
FRONTEND_URL=https://your-echoo-domain.example

# LiveKit Cloud/public LiveKit. Both browser-facing URLs must use wss://.
LIVEKIT_URL=
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_MINUTES=120
MEDIA_RELAY_MODE=livekit-only

# Coalesce many simultaneous listener-presence refreshes into one LiveKit read.
# Keep these short: LiveKit remains the real source of truth.
LIVE_PRESENCE_CACHE_MS=1500
LIVE_PRESENCE_DB_SYNC_MS=5000

# Mandatory recording runtime.
# The backend process/container must be able to execute BOTH binaries.
# Verify after deploy with GET /api/health/recording.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Canonical live replay MP3 quality.
AUDIO_REPLAY_MP3_BITRATE=320k

# Recording storage.
# On a persistent VPS, leave AUDIO_STORAGE_PROVIDER blank to keep canonical MP3
# files under backend/uploads/audio/ (that directory must be persistent/backed up).
# On an ephemeral/container/serverless host, configure S3-compatible storage.
AUDIO_STORAGE_PROVIDER=
AUDIO_S3_BUCKET_PUBLIC=false
AUDIO_S3_ENDPOINT=
AUDIO_S3_REGION=auto
AUDIO_S3_BUCKET=
AUDIO_S3_ACCESS_KEY_ID=
AUDIO_S3_SECRET_ACCESS_KEY=
AUDIO_S3_PUBLIC_BASE=
AUDIO_S3_PREFIX=echoo-recordings
AUDIO_KEEP_LOCAL_AFTER_ARCHIVE=false

# Redis is not required by the Echoo Node API when LiveKit Cloud manages its own infrastructure.
# If the Echoo API itself is horizontally scaled, add a Socket.IO shared adapter
# (for example Redis) before relying on cross-instance chat/presence rooms.
REDIS_URL=

# Parallel live draft transcription and background quality pass.
WHISPER_FLOW_URL=wss://your-whisper-host.example/ws
WHISPER_FLOW_API_KEY=
WHISPER_QUALITY_FLOW_URL=
WHISPER_QUALITY_FLOW_API_KEY=
WHISPER_QUALITY_MODEL=faster-whisper-large-v3-turbo
WHISPER_MODEL=faster-whisper-large-v3-turbo
WHISPER_LANGUAGE=en


# Deployment authority:
# Read ../HOSTING.md before using this template in production. A successful
# backend start is not sufficient; /api/health/recording must report
# automaticServerMp3=true and trimming=true before production broadcasts.
