NODE_ENV=production
PORT=5001

# Public Cloudflare Pages frontend. Add your custom domain too if you use one.
CLIENT_ORIGINS=https://echoo-test.pages.dev
# Allows trusted Cloudflare preview subdomains such as <hash>.echoo-test.pages.dev.
CLIENT_ORIGIN_SUFFIXES=echoo-test.pages.dev

# MongoDB Atlas or another public MongoDB deployment.
MONGODB_URI=

# Use two different long random values.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# LiveKit Cloud/public LiveKit. Both browser-facing URLs must use wss://.
LIVEKIT_URL=
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
MEDIA_RELAY_MODE=livekit-only

# Redis is not required by the Echoo Node API when LiveKit Cloud manages its own infrastructure.
# Keep REDIS_URL only if another deployed component needs it.
REDIS_URL=
