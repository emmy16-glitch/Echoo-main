NODE_ENV=production
PORT=5001

# Public Cloudflare Pages frontend. Add your custom domain too if you use one.
CLIENT_ORIGINS=https://echoo-test.pages.dev
# Allows trusted Cloudflare preview subdomains such as <hash>.echoo-test.pages.dev.
CLIENT_ORIGIN_SUFFIXES=echoo-test.pages.dev

# MongoDB Atlas or another public MongoDB deployment.
MONGODB_URI=
# Bounded pool for listener bursts, chat and creator dashboard traffic.
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_POOL_SIZE=25

# Use two different long random values.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# LiveKit Cloud/public LiveKit. Both browser-facing URLs must use wss://.
LIVEKIT_URL=
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_MINUTES=120
MEDIA_RELAY_MODE=livekit-only

# Coalesce many simultaneous listener-presence refreshes into one LiveKit read.
# Keep these short: LiveKit remains the real source of truth.
LIVE_PRESENCE_CACHE_MS=1500
LIVE_PRESENCE_DB_SYNC_MS=5000

# Redis is not required by the Echoo Node API when LiveKit Cloud manages its own infrastructure.
# If the Echoo API itself is horizontally scaled, add a Socket.IO shared adapter
# (for example Redis) before relying on cross-instance chat/presence rooms.
REDIS_URL=
