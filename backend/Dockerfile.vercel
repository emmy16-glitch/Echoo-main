FROM node:22-bookworm-slim

ENV NODE_ENV=production

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY src ./src

# These paths are working/temp space only on Vercel. Canonical production media
# must be archived to configured object storage before local cleanup.
RUN mkdir -p \
  uploads/audio \
  uploads/audio-covers \
  uploads/avatars \
  uploads/stations \
  uploads/collection-covers \
  uploads/temp \
  uploads/transcript-chunks \
  data/broadcast-masters

CMD ["npm", "start"]
