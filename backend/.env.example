NODE_ENV=development
PORT=5001

# Database
MONGODB_URI=

# Auth
JWT_SECRET=
JWT_REFRESH_SECRET=

# Redis
REDIS_URL=redis://127.0.0.1:6379

# LiveKit
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Current Echoo architecture:
# creator -> LiveKit -> listeners
MEDIA_RELAY_MODE=livekit-only

# Future optional relay infrastructure
OME_RTMP_HOST=
OME_RTMP_PORT=1935
OME_APP_NAME=app
OME_VHOST=default
OME_API_URL=
OME_PUBLIC_URL=
OME_API_KEY=
