NODE_ENV=development
PORT=5017
FRONTEND_URL=http://localhost:5174

# Email delivery via Resend (https://resend.com). Create an API key and verify
# your sending domain, then set EMAIL_FROM to a verified "from" address.
# Keep real values only in backend/.env — never commit secrets.
RESEND_API_KEY=
EMAIL_FROM=Echoo <no-reply@yourdomain.com>

# Optional: send a "New sign-in detected" security email after each login.
# Off by default so users are not emailed on every sign-in.
EMAIL_NEW_SIGNIN_ALERTS=false

# Frontend origins allowed to call the API and Socket.IO.
# Local Echoo Vite runs on the project-specific port 5273 (see
# frontend/vite.config.js — not Vite's 5173 default, to avoid collisions on
# shared machines). Add any additional trusted frontend origins as a
# comma-separated list.
CLIENT_ORIGINS=http://localhost:5273,http://127.0.0.1:5273
CLIENT_ORIGIN_SUFFIXES=

# Database
# IMPORTANT FOR COLLABORATIVE TESTING:
# Every developer who should see the same Echoo accounts, stations and broadcasts
# must use the same shared MONGODB_URI. If this is blank in development, Echoo
# falls back to mongodb://127.0.0.1:27017/echoo, which is machine-local data.
MONGODB_URI=

# Auth
# Collaborators should use the same JWT secrets when testing the same environment.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://127.0.0.1:6379

# LiveKit
# LiveKit Cloud example:
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_PUBLIC_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your_api_key
# LIVEKIT_API_SECRET=your_api_secret
#
# LIVEKIT_API_SECRET is backend-only. Never expose or commit it to the frontend.
LIVEKIT_URL=
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Lifetime of LiveKit participant tokens, in minutes. Defaults to 120 (2 hours).
# Clients re-fetch tokens on every join/reconnect, so long sessions auto-reissue.
LIVEKIT_TOKEN_TTL_MINUTES=120
# Wait this long for a creator WebRTC reconnect before ending a live broadcast.
LIVEKIT_CREATOR_DISCONNECT_GRACE_MS=20000

# Parallel server-side transcription. This URL is backend-only and must never be
# exposed through a VITE_ variable. Leave blank to disable transcription without
# affecting LiveKit audio.
WHISPER_FLOW_URL=ws://127.0.0.1:8181/ws
# Required shared bearer credential. It exists only in the backend and the
# private Whisper service; never expose it through a VITE_ variable.
WHISPER_FLOW_API_KEY=
# Optional: use a separate quality endpoint/model; otherwise the live endpoint is reused in quality mode.
WHISPER_QUALITY_FLOW_URL=
WHISPER_QUALITY_FLOW_API_KEY=
WHISPER_QUALITY_MODEL=faster-whisper-large-v3-turbo
WHISPER_MODEL=faster-whisper-large-v3-turbo
WHISPER_LANGUAGE=en
TRANSCRIPTION_MAX_BUFFER_BYTES=2097152
TRANSCRIPTION_MAX_BUFFER_FRAMES=250
TRANSCRIPTION_MAX_RETRIES=5

# Current Echoo architecture:
# creator -> LiveKit -> listeners
MEDIA_RELAY_MODE=livekit-only

# Optional secondary outputs. Both consume the authenticated 48 kHz stereo
# 24-bit PCM master chunks directly, independently of LiveKit/Opus.
# FFmpeg must be installed on the server; set FFMPEG_PATH only when it is not
# available on PATH. Keep MASTER_ARCHIVE_DIR on private persistent storage,
# outside any public static upload directory.
FFMPEG_PATH=ffmpeg
MASTER_ARCHIVE_ENABLED=false
MASTER_ARCHIVE_DIR=
# Set true only after configuring an Icecast-compatible source endpoint.
RADIO_STREAM_ENABLED=false
RADIO_STREAM_HOST=
RADIO_STREAM_PORT=8000
RADIO_STREAM_MOUNT=/echoo.mp3
RADIO_STREAM_USERNAME=
RADIO_STREAM_PASSWORD=
# Public listener base, e.g. https://radio.example.com (no secret here).
RADIO_PUBLIC_BASE_URL=

# Recording archive: live shows send bounded PCM/WAV chunks while the show
# is running. The server uses FFmpeg to create the canonical replay MP3 at End
# Broadcast — there is no giant final WAV upload. FFmpeg AND FFprobe are
# required for automatic server MP3 creation and saved-recording trimming.
# Unset/disabled S3 = MP3 stays on local server disk under uploads/audio/.
# With S3 configured, the canonical MP3 can be archived to object storage.
# Device copies are separate: creators choose MP3, WAV, or server-only once.
#
# FREE storage without a credit card: Backblaze B2 (10 GB free, S3 API).
# B2 setup: backblaze.com → free account (email only) → B2 Cloud Storage →
#   Create Bucket `echoo-recordings` as PRIVATE (public buckets cost $1) →
#   App Keys → key with Read+Write on that bucket.
# Private buckets stream via short-lived signed URLs minted at playback time
# (no bucket change needed later). If you ever switch to a PUBLIC bucket
# (R2 public / B2 paid-public), set AUDIO_S3_BUCKET_PUBLIC=true instead.
AUDIO_STORAGE_PROVIDER=
AUDIO_S3_BUCKET_PUBLIC=false
# e.g. https://<account-id>.r2.cloudflarestorage.com (no trailing slash)
AUDIO_S3_ENDPOINT=
AUDIO_S3_REGION=auto
AUDIO_S3_BUCKET=
AUDIO_S3_ACCESS_KEY_ID=
AUDIO_S3_SECRET_ACCESS_KEY=
# e.g. https://pub-<hash>.r2.dev — the public base players stream from.
AUDIO_S3_PUBLIC_BASE=
AUDIO_S3_PREFIX=echoo-recordings
# Canonical live replay MP3. Default 320k stereo (≈144 MB/hr) keeps
# the replay close to the original 48 kHz PCM master while remaining far
# smaller than WAV. This is independent of generic uploaded-audio archiving.
AUDIO_REPLAY_MP3_BITRATE=320k
# Generic/manual-upload archive transcode setting.
AUDIO_MP3_BITRATE=192k
# Legacy Opus bitrate (kept for old replays only — new replays use MP3).
AUDIO_OPUS_BITRATE=48k
# Keep the local WAV after a successful archive (normally false — the cloud
# copy becomes the canonical file).
AUDIO_KEEP_LOCAL_AFTER_ARCHIVE=false

# Future optional relay infrastructure
OME_RTMP_HOST=
OME_RTMP_PORT=1935
OME_APP_NAME=app
OME_VHOST=default
OME_API_URL=
OME_PUBLIC_URL=
OME_API_KEY=

# After creating or changing backend/.env, RESTART `npm run dev` so Node loads
# the new MongoDB, JWT and LiveKit values.
