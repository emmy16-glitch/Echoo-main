NODE_ENV=development
PORT=5001

# Frontend origins allowed to call the API and Socket.IO.
# Local Echoo Vite runs on port 5174.
# Add any additional trusted frontend origins as a comma-separated list.
CLIENT_ORIGINS=
CLIENT_ORIGIN_SUFFIXES=

# Database
# IMPORTANT FOR COLLABORATIVE TESTING:
# Every developer who should see the same Echoo accounts, stations and broadcasts
# must use the same shared MONGODB_URI. If this is blank in development, Echoo
# falls back to mongodb://127.0.0.1:27017/echoo, which is machine-local data.
MONGODB_URI=

# Auth
# Collaborators should use the same JWT secrets when testing the same environment.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://127.0.0.1:6379

# LiveKit
# LiveKit Cloud example:
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_PUBLIC_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your_api_key
# LIVEKIT_API_SECRET=your_api_secret
#
# LIVEKIT_API_SECRET is backend-only. Never expose or commit it to the frontend.
LIVEKIT_URL=
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Lifetime of LiveKit participant tokens, in minutes. Defaults to 120 (2 hours).
# Clients re-fetch tokens on every join/reconnect, so long sessions auto-reissue.
LIVEKIT_TOKEN_TTL_MINUTES=120
# Wait this long for a creator WebRTC reconnect before ending a live broadcast.
LIVEKIT_CREATOR_DISCONNECT_GRACE_MS=20000

# Parallel server-side transcription. This URL is backend-only and must never be
# exposed through a VITE_ variable. Leave blank to disable transcription without
# affecting LiveKit audio.
WHISPER_FLOW_URL=ws://127.0.0.1:8181/ws
# Required shared bearer credential. It exists only in the backend and the
# private Whisper service; never expose it through a VITE_ variable.
WHISPER_FLOW_API_KEY=
# Optional: use a separate quality endpoint/model; otherwise the live endpoint is reused in quality mode.
WHISPER_QUALITY_FLOW_URL=
WHISPER_QUALITY_FLOW_API_KEY=
WHISPER_QUALITY_MODEL=faster-whisper-large-v3-turbo
WHISPER_MODEL=faster-whisper-large-v3-turbo
WHISPER_LANGUAGE=en
TRANSCRIPTION_MAX_BUFFER_BYTES=2097152
TRANSCRIPTION_MAX_BUFFER_FRAMES=250
TRANSCRIPTION_MAX_RETRIES=5

# Current Echoo architecture:
# creator -> LiveKit -> listeners
MEDIA_RELAY_MODE=livekit-only

# Future optional relay infrastructure
OME_RTMP_HOST=
OME_RTMP_PORT=1935
OME_APP_NAME=app
OME_VHOST=default
OME_API_URL=
OME_PUBLIC_URL=
OME_API_KEY=

# After creating or changing backend/.env, RESTART `npm run dev` so Node loads
# the new MongoDB, JWT and LiveKit values.
