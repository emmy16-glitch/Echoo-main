NODE_ENV=development
PORT=5001

# Frontend origins allowed to call the API and Socket.IO.
# Development defaults already allow localhost/LAN Vite on port 5174.
# Production example:
# CLIENT_ORIGINS=https://echoo-test.pages.dev,https://echoo.example.com
CLIENT_ORIGINS=

# Optional hostname suffixes for trusted preview deployments.
# Example for Cloudflare Pages preview URLs:
# CLIENT_ORIGIN_SUFFIXES=echoo-test.pages.dev
CLIENT_ORIGIN_SUFFIXES=

# Database
MONGODB_URI=

# Auth
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://127.0.0.1:6379

# LiveKit
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Current Echoo architecture:
# creator -> LiveKit -> listeners
MEDIA_RELAY_MODE=livekit-only

# Future optional relay infrastructure
OME_RTMP_HOST=
OME_RTMP_PORT=1935
OME_APP_NAME=app
OME_VHOST=default
OME_API_URL=
OME_PUBLIC_URL=
OME_API_KEY=
