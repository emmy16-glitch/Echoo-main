# =============================================
# Echoo backend: ngrok tunnel development
# =============================================
# Copy this file to backend/.env when exposing the API through ngrok:
#
#   cp backend/.env.ngrok.example backend/.env
#
# NOTE: .env is ignored by git, so your secrets stay local.
# Only the base values (MONGODB_URI, JWT secrets) need copying
# from your existing backend/.env — this file covers the
# tunnel-specific parts.

NODE_ENV=development
PORT=5001

# --- Database (copy from your backend/.env) --------------------------
# MONGODB_URI=mongodb+srv://...

# --- Auth (copy from your backend/.env) ------------------------------
# JWT_SECRET=...
# JWT_REFRESH_SECRET=...

# --- Redis -----------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# --- LiveKit ---------------------------------------------------------
# Public testing over HTTPS requires a public wss:// LiveKit endpoint.
# LOCAL ws:// only works for browsers opened on http://localhost or the LAN.
# LIVEKIT_URL=wss://<your-project>.livekit.cloud
# LIVEKIT_PUBLIC_URL=wss://<your-project>.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# --- ngrok tunnel specifics ------------------------------------------
# The random subdomain ngrok gives your frontend URL on the free plan.
# Example: https://abc123.ngrok-free.app  -> set to https://abc123.ngrok-free.app
#
# The frontend needs this so it can POST to the tunneled API instead of
# http://localhost:5001. Update it every time you restart ngrok.
VITE_API_URL=

# Allow ANY ngrok frontend URL through CORS by matching the hostname
# suffix instead of a fixed origin. This avoids editing the backend
# .env every time ngrok assigns a new random subdomain.
CLIENT_ORIGIN_SUFFIXES=ngrok-free.app,ngrok-free.dev
# If you also want fixed origins (e.g. another dev machine):
# CLIENT_ORIGINS=http://localhost:5174
