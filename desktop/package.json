{
  "name": "echoo-studio",
  "version": "1.0.5",
  "desktopName": "echoo-studio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux deb AppImage tar.gz",
    "test": "node --test test-audio-controls.mjs"
  },
  "build": {
    "appId": "com.echoo.studio",
    "productName": "Echoo Studio",
    "executableName": "echoo-studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz",
        "dir"
      ],
      "icon": "build/icons/512x512.png",
      "category": "AudioVideo",
      "syncDesktopName": true,
      "artifactName": "Echoo-Studio-${version}-${arch}.${ext}"
    }
  },
  "keywords": [],
  "author": {
    "name": "Echoo Team",
    "email": "support@echoo.com"
  },
  "homepage": "https://echoo.digi02.org",
  "license": "UNLICENSED",
  "description": "Echoo Studio - Real-time Audio Broadcasting Desktop App",
  "repository": {
    "type": "git",
    "url": "https://github.com/effiukp/Echoo-main.git"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1"
  }
}
