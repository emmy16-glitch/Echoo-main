{
  "name": "echoo-desktop",
  "version": "1.0.6",
  "description": "Echoo native desktop shell (hosted thin client for https://echoo.digi02.org — zero setup, always in sync with live)",
  "main": "src/main.js",
  "private": true,
  "desktopName": "echoo-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/emmy16-glitch/Echoo-main.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev-launcher.js",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:win:local-backend": "node scripts/prepare-bundled-backend.js && npm run build --prefix ../frontend && electron-builder --win",
    "test": "node --test test-audio-controls.mjs"
  },
  "dependencies": {
    "electron-log": "^5.4.2",
    "electron-updater": "^6.7.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.echoo.desktop",
    "productName": "Echoo",
    "copyright": "Copyright © 2026 Echoo",
    "afterSign": "scripts/afterSign.js",
    "files": [
      "src/**/*",
      "offline.html",
      "assets/**/*",
      "build/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "notarize": false
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Echoo-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "AudioVideo",
      "syncDesktopName": true
    },
    "publish": {
      "provider": "github",
      "owner": "emmy16-glitch",
      "repo": "Echoo-main"
    }
  }
}
